{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "pool": "forks", "dir": "src" },
  "checkers": [],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/agenda/AgendaWindow.tsx",
    "src/alert/AlertWindow.tsx",
    "src/app/App.tsx",
    "src/main.tsx",
    "src/quick/QuickWindow.tsx",
    "src/settings/SettingsWindow.tsx",
    "src/ui/AuthScreen.tsx",
    "src/ui/Button.tsx",
    "src/ui/CommandMenu.tsx",
    "src/ui/ErrorBoundary.tsx",
    "src/ui/EventEditor.tsx",
    "src/ui/FeedbackForm.tsx",
    "src/ui/FreeSlots.tsx",
    "src/ui/MonthView.tsx",
    "src/ui/QuickAdd.tsx",
    "src/ui/RateCard.tsx",
    "src/ui/RepeatField.tsx",
    "src/ui/ScheduleView.tsx",
    "src/ui/Search.tsx",
    "src/ui/Settings.tsx",
    "src/ui/SettingsButton.tsx",
    "src/ui/Shortcuts.tsx",
    "src/ui/Sidebar.tsx",
    "src/ui/SignInActions.tsx",
    "src/ui/TimeGrid.tsx",
    "src/ui/TimeZoneSelect.tsx",
    "src/ui/Toolbar.tsx",
    "src/ui/UndoToast.tsx",
    "src/ui/ViewMenu.tsx",
    "src/ui/Welcome.tsx",
    "src/widget/Widget.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.d.ts",
    "!src/shared/i18n/!(index).ts",
    "!src/shared/api/mock.ts",
    "!src/shared/api/types.ts"
  ],
  "ignoreStatic": false,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": 87 }
}
