{
  "name": "calm-calendar",
  "private": true,
  "version": "0.14.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "typecheck:e2e": "tsc -p e2e",
    "build:e2e": "tsc && vite build --mode e2e",
    "build:app-e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "test:app": "node --test --test-concurrency=1 \"e2e/app/*.app.mjs\"",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/unbounded": "5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "effector": "23.4.4",
    "effector-react": "23.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.1.0",
    "webdriverio": "^10.1.0"
  },
  "description": "Calendar for Windows without ads"
}
