{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, desktop widget, the meeting alert, the tray agenda and the quick add window",
  "windows": [
    "main",
    "widget",
    "alert",
    "agenda",
    "quick"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-theme"
  ]
}
