{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calm Calendar",
  "mainBinaryName": "calm-calendar",
  "version": "0.7.0",
  "identifier": "com.arseni.calmcalendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calm Calendar",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "transparent": true
      },
      {
        "label": "widget",
        "title": "Calm Calendar widget",
        "url": "index.html?window=widget",
        "width": 300,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "x": 40,
        "y": 40
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Arseni",
    "shortDescription": "Ad-free calendar for Windows",
    "longDescription": "Ad-free calendar for Windows with Google Calendar: day, week and month views, a desktop widget, quick add and reminders.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
